# Database — SQLite for local dev, Postgres (e.g. Neon) for production.
# Local default:
DATABASE_URL="file:./dev.db"
# Production example (Postgres):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Use a long random string in production.
APP_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app, used to build shareable invite links.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Free API token from https://www.football-data.org/ (used by /api/sync).
# Optional: without it you can still enter results manually.
FOOTBALL_DATA_API_TOKEN=""

# Shared secret to protect the /api/sync cron endpoint (sent as ?key=...).
SYNC_SECRET="change-me-too"
